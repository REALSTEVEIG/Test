# Server
PORT=3000

# Logging: error | warn | info | debug (silent during tests unless set)
LOG_LEVEL=info

# Persistence: memory (default) | file
PERSISTENCE=memory
# Directory used when PERSISTENCE=file
DATA_DIR=./data

# Payment processing simulation
# How long the simulated gateway takes before settling (ms)
PROCESSING_DELAY_MS=800
# Probability [0..1] that a payment fails during processing
PAYMENT_FAILURE_RATE=0.15
