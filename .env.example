# ---- Server ----
NODE_ENV=development
PORT=3000

# Logging: error | warn | info | debug | silent
LOG_LEVEL=info

# ---- Persistence ----
# memory (default) | file
PERSISTENCE=memory
# Directory used when PERSISTENCE=file
DATA_DIR=data

# ---- Payment processing simulation ----
# How long the simulated gateway takes before settling (ms)
PROCESSING_DELAY_MS=800
# Probability [0..1] that a payment fails during processing
PAYMENT_FAILURE_RATE=0.15

# ---- HTTP / security ----
# Max JSON body size
BODY_LIMIT=100kb
# CORS allowed origin ("*" or a specific origin)
CORS_ORIGIN=*
# Rate limiting (per window, per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
